# =============================================================================
# CLOIS — Community Lifecycle Orchestration and Intelligence System
# .gitignore
# =============================================================================


# =============================================================================
# Environment & Secrets
# =============================================================================
.env
.env.*
!.env.example
!.env.test.example
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
secrets/
credentials.json


# =============================================================================
# Node.js / npm / yarn / pnpm
# =============================================================================
node_modules/
.npm/
.yarn/
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
package-lock.json.bak
yarn-error.log
.pnpmfile.cjs


# =============================================================================
# Build & Distribution Output
# =============================================================================
dist/
build/
out/
.next/
.nuxt/
.output/
.vite/
*.tsbuildinfo
tsconfig.tsbuildinfo


# =============================================================================
# CDK & AWS Infrastructure
# =============================================================================
# CDK generated output
cdk.out/
infrastructure/cdk.out/
# CDK context (machine-specific, not source)
cdk.context.json
# SAM local
.aws-sam/
samconfig.toml
# AWS credentials / config (never commit)
.aws/
# Lambda zip artifacts
*.zip
lambda-packages/
infrastructure/dist/
infrastructure/build/


# =============================================================================
# Test & Coverage Output
# =============================================================================
coverage/
.coverage
htmlcov/
lcov.info
*.lcov
.nyc_output/
test-results/
playwright-report/
test-report.xml
vitest.config.*.timestamp-*


# =============================================================================
# Python (reporter script runtime artefacts, venvs)
# =============================================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python
venv/
.venv/
env/
.env/
pip-wheel-metadata/
*.egg-info/
dist-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/


# =============================================================================
# Logs & Temporary Files
# =============================================================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.tmp/
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo


# =============================================================================
# OS-Generated Files
# =============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Linux
*~


# =============================================================================
# IDE & Editor Files
# =============================================================================
# VS Code (keep .vscode/extensions.json and .vscode/settings.json if shared)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
# JetBrains
.idea/
*.iml
*.iws
# Vim
*.swp
*.swo
# Emacs
\#*\#
*.elc
# Sublime Text
*.sublime-workspace
# Cursor
.cursor/


# =============================================================================
# Kiro — Local / Generated Files (do NOT commit)
# =============================================================================
# Session-state and local user config generated by Kiro at runtime
.kiro/mcp.json
.kiro/.session/
.kiro/cache/
# Kironomics temp counters (written by hooks to /tmp, but guard here too)
kironomics_*.tmp

# NOTE: The following Kiro files ARE committed (required for Kiro University):
#   .kiro/specs/**          — specification documents (requirements, design, tasks)
#   .kiro/hooks/**          — hook configurations
#   .kiro/steering/**       — steering files
#   .kiro/ugmdu.json        — UGMDU / Kironomics workspace config


# =============================================================================
# Miscellaneous Generated / Local Config
# =============================================================================
# Local override config files
*.local
*.local.*
local.config.*
# Serverless framework
.serverless/
# Terraform (if ever used)
.terraform/
*.tfstate
*.tfstate.backup
# Docker local overrides
docker-compose.override.yml
# Storybook build
storybook-static/
# Turbo cache
.turbo/
